[Unit]
Description=Apply route-pilot credential operations
After=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/libexec/routepilot-control
TimeoutStartSec=90
UMask=0077
LimitCORE=0
CoredumpFilter=0x0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ReadWritePaths=/var/lib/routepilot /var/lib/routepilot-devices /var/lib/routepilot-control
# The installer adds the exact Xray configuration directory as a writable path.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryMax=96M
