{
  "name": "routepilot-web",
  "main": "web-shell.mjs",
  "services": [{"binding": "ROUTEPILOT_SERVER", "service": "routepilot-server"}],
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "../web/dist-status",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"],
    "not_found_handling": "404-page"
  }
}
